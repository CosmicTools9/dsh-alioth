{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/vendor/**",
    "packages/alioth/auth-web-alioth/lib/client.js"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "tests/*.spec.ts"
      ],
      "project": [
        "scripts/**/*.ts",
        "tests/**/*.ts"
      ],
      "ignoreBinaries": [
        "footprint"
      ],
      "ignoreDependencies": [
        "@deepseek-ai/dsh",
        "@deepseek-ai/dsh-credentials-local",
        "@deepseek-ai/dsh-llm-deepseek",
        "@deepseek-ai/dsh-session-persistence-jsonl",
        "@deepseek-ai/dsh-tool-todo",
        "pg"
      ]
    },
    "packages/alioth/bundle-alioth": {
      "entry": [
        "cordis.patch.yml"
      ],
      "ignoreDependencies": [
        "@dsh-alioth/*"
      ]
    },
    "packages/alioth/tool-alioth-meta": {
      "entry": [
        "tests/probe-semantic.ts"
      ]
    },
    "packages/alioth/env-alioth": {
      "ignoreDependencies": [
        "acorn",
        "cheerio",
        "css-tree",
        "meriyah",
        "postcss-selector-parser"
      ],
      "entry": [
        "tests/fixtures/*.mts"
      ]
    },
    "examples/*": {
      "entry": [
        "cordis.yml",
        "web.patch.yml"
      ],
      "ignoreDependencies": [
        "@dsh-alioth/*",
        "@deepseek-ai/*"
      ]
    }
  }
}
