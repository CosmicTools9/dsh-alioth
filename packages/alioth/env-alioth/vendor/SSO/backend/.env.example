# SSO Backend 环境变量配置
# 复制此文件为 .env 即可使用（通用开发占位符已加密）
#
# 说明：非敏感配置由 .mise.toml [env] 统一管理。
# 敏感配置以密文存储，使用根目录 .encryption_key 解密。
# 运行 `mise env` 可查看最终生效的环境变量。
#
# 加密工具: ./scripts/env-vault.sh encrypt "<value>"

# 服务器监听地址（由 .mise.toml 提供默认值）
# SERVER_ADDR=0.0.0.0:9001

# 数据库连接
DATABASE_URL=enc:7bdfd4ad16012000226605eec03a0144:YYvYe9VshMxy1Gbli0VqhNmH4wAaXt/1oD589ITCMw2PlqlDr8mREypxLqKMhshXpU4CNICiFN8eO2ZfwzK/0g==

# SSO JWT ES256 私钥（EC P-256, PEM/PKCS#8）
# 推荐：使用 _PATH 引用 .dev/ 下的 PEM 文件
#   1. 生成密钥对（如果 .dev/ 还没有）：
#      openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt -out .dev/jwt_private.pem
#      openssl pkey -in .dev/jwt_private.pem -pubout -out .dev/jwt_public.pem
#   2. 设 _PATH 指向文件（私钥是敏感材料，确保 .dev/ 在 .gitignore）：
SSO_JWT_PRIVATE_KEY_PATH=../../.dev/jwt_private.pem
# 兼容：也可直接用 SSO_JWT_PRIVATE_KEY 注入完整 PEM（单行，base64 不含换行）
# 警告：不要使用 enc: 前缀，dotenvy 不会解密，SSO 签名会失败
# SSO_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----MIIEvQIB...-----END PRIVATE KEY-----"
#

# 加密密钥（用于加密敏感数据）
ENCRYPTION_KEY=enc:b186bc9d2d91379a1a2f59c9eb645aa6:SWGsOVCd/egWpNKQ5zVoMUmnz1256ySgHmxL5RvTB80=

# JWT Access Token 过期时间（由 .mise.toml 提供默认值）
# JWT_ACCESS_EXPIRY=900

# JWT Refresh Token 过期时间（由 .mise.toml 提供默认值）
# JWT_REFRESH_EXPIRY=604800

# OAuth Google 配置（可选）
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# OAuth GitHub 配置（可选）
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# OAuth 回调 URL（由 .mise.toml 提供默认值）
# OAUTH_REDIRECT_URL=http://localhost:9002/auth/callback

# 日志级别（由 .mise.toml 提供默认值）
# LOG_LEVEL=info

# 身份证实模式：local（默认，本地核验数据完整性）| external（调用第三方 API）
# IDENTITY_VERIFY_MODE=local
# 第三方身份证实 API URL（IDENTITY_VERIFY_MODE=external 时使用）
# IDENTITY_EXTERNAL_VERIFY_URL=https://verify.example.com/api/verify

# ─────────────────────────────────────────────────────────────
# 独立部署模式（SSO 作为单独应用，而非内嵌于 Gateway）
# ─────────────────────────────────────────────────────────────
# 监听地址（独立部署默认 9002，与内嵌进 Gateway 的 9001 区分）
SERVER_ADDR=0.0.0.0:9002
# 独立部署时 DATABASE_URL 应指向与 Gateway 共享的 isahl_auth 库
#   （基础 schema 由 reset-db.sh 提供，SSO 迁移 004-007 为增量）
# JWT 密钥：独立部署时必须显式提供，且 Gateway(sso-remote 模式) 需配置
#   同一份 SSO_JWT_PUBLIC_KEY / SSO_JWT_ISSUER 才能验证其下发的令牌。
# SSO_JWT_PRIVATE_KEY_PATH=../../.dev/jwt_private.pem
# SSO_JWT_PUBLIC_KEY_PATH=../../.dev/jwt_public.pem
# SSO_JWT_ISSUER=alioth-sso
# 远端调用方(Gateway)指向本服务的地址
# SSO_SERVICE_URL=http://localhost:9002
#
# ⚠️ 若 Gateway 以 sso feature 构建（内嵌 SSO，见 Gateway/backend/Cargo.toml），
#    不应把 Gateway 侧 SSO_SERVICE_URL 指向独立进程（如 9008）——Gateway 的
#    PDP/JWT 校验会因此产生外部进程单点；进程被 SIGKILL 时 PEP fail-close
#    全量 403。此时应在 Gateway 侧 .env 配置
#    SSO_SERVICE_URL=http://127.0.0.1:9001（自指内嵌路由）。
