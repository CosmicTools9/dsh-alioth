# Gateway Backend 环境变量配置
# 复制此文件为 .env 即可使用（通用开发占位符已加密）
#
# 说明：非敏感配置由 .mise.toml [env] 统一管理。
# 敏感配置以密文存储，使用根目录 .encryption_key 解密。
# 运行 `mise env` 可查看最终生效的环境变量。
#
# 加密工具: ./scripts/env-vault.sh encrypt "<value>"

# ===========================================
# 服务器配置
# ===========================================

# 服务器监听地址（由 .mise.toml 提供默认值）
# SERVER_ADDR=127.0.0.1:9001

# 日志级别（由 .mise.toml 提供默认值）
# RUST_LOG=info

# ===========================================
# 数据库配置
# ===========================================

# PostgreSQL 连接字符串
DATABASE_URL=enc:7d11c4e091a2a2f8b644bda7c53d6896:fz0ZNT4ysCMAs/ajfwt6NkkwUU0iAo8ef5V/Fme++wAILpvvmvd9nJ53ib9HhGb9

# 连接池大小（由 .mise.toml 提供默认值）
# DATABASE_POOL_SIZE=10

# 连接超时（由 .mise.toml 提供默认值）
# DATABASE_TIMEOUT=30

# ===========================================
# SSO 认证配置
# ===========================================

# SSO 服务地址（由 .mise.toml 提供默认值）
# sso-remote 构建（独立 SSO）时指向外部 SSO，如 http://127.0.0.1:9002。
# sso feature 构建（内嵌 SSO）时务必自指本进程：
#   SSO_SERVICE_URL=http://127.0.0.1:9001
# 外部进程单点会导致 PDP fail-close 全量 403（详见 SSO/backend/.env.example 注释）。
# Meta 后端服务地址（用于 /api/meta/* 代理路由）
# META_SERVICE_URL=http://127.0.0.1:4949

# SSO JWT ES256 公钥（PEM），用于验证 SSO 签发的 token
# 推荐：使用 _PATH 引用 .dev/ 下的 PEM 文件
#   1. 生成密钥对（如果 .dev/ 还没有）：
#      openssl ecparam -genkey -name prime256v1 -noout -out .dev/jwt_private.pem
#      openssl ec -in .dev/jwt_private.pem -pubout -out .dev/jwt_public.pem
#   2. 设 _PATH 指向文件（公钥可明文）：
SSO_JWT_PUBLIC_KEY_PATH=../../.dev/jwt_public.pem
# 兼容：也可直接用 SSO_JWT_PUBLIC_KEY 注入完整 PEM（单行，base64 不含换行）
# 警告：不要使用 enc: 前缀，dotenvy 不会解密，签名验证会失败（InvalidSignature）
# SSO_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----MIIBIjAN...-----END PUBLIC KEY-----"
#
# Standalone 模式 ES256 私钥（不配则用嵌入式开发密钥，仅限本地开发）
# GATEWAY_JWT_PRIVATE_KEY=
#

# JWT Access Token 过期时间（由 .mise.toml 提供默认值）
# JWT_ACCESS_EXPIRY=900

# JWT Refresh Token 过期时间（由 .mise.toml 提供默认值）
# JWT_REFRESH_EXPIRY=604800

# ===========================================
# NGAC 授权配置
# ===========================================

# 以下配置由 .mise.toml 提供默认值，如需覆盖请取消注释
# NGAC_ROUTING_STRATEGY=auto
# NGAC_CACHE_SIZE=10000
# NGAC_CACHE_TTL=60
# AGE_ENABLE=true
# AGE_GRAPH_NAME=isahl_auth

# ===========================================
# 应用配置
# ===========================================

# 以下配置由 .mise.toml 提供默认值，如需覆盖请取消注释
# Gateway 实例绑定的 namespace，控制加载哪个 namespace 的 App
# 若不设置，在有多个 namespace 时 PreprocDiscovery 会返回错误
# NAMESPACE=Cosmic-Tools
# DEPLOY_PATH — release 模式数据路径（可选）
# 设置后 Gateway 从 Deploy/{namespace}/ 而非 Pre-Proc/{namespace}/ 读取
# 由 scripts/deploy/release-to-namespace.sh 自动生成
# DEPLOY_PATH=../../Deploy
#
# 以下保留仅用于 dev 模式覆盖:
# PREPROC_APPS_PATH=../../Pre-Proc
# DEFAULT_APP=my-app

# ===========================================
# CORS 配置
# ===========================================

# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ===========================================
# 监控配置
# ===========================================

# 以下配置由 .mise.toml 提供默认值，如需覆盖请取消注释
# METRICS_ENABLED=true
# OTEL_ENABLED=false

# ===========================================
# 调试配置
# ===========================================

# 以下配置由 .mise.toml 提供默认值，如需覆盖请取消注释
# DEBUG_MODE=false
# VERBOSE_LOGGING=false
