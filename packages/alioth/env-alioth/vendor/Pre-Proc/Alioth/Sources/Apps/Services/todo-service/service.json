{
  "id": "todo-service",
  "namespace": "Alioth",
  "version": "0.1.0",
  "domain": "任务",
  "layer": 1,
  "hasBackend": true,
  "hasFrontend": false,
  "factors": [],
  "dtoDependencies": [],
  "dtoExposes": {
    "queries": ["list", "detail"],
    "refs": ["Todo"]
  },
  "publishes": [],
  "services": [
    {
      "endpoint": "GET /service/todos",
      "purpose": "service/todos 资源列表（crud_routes 工厂展开；框架 ListQuery 分页）"
    },
    {
      "endpoint": "POST /service/todos",
      "purpose": "service/todos 资源新建（crud_routes 工厂展开）"
    },
    {
      "endpoint": "GET /service/todos/{id}",
      "purpose": "service/todos 单条查询（crud_routes 工厂展开）"
    },
    {
      "endpoint": "PUT /service/todos/{id}",
      "purpose": "service/todos 更新（crud_routes 工厂展开）"
    },
    {
      "endpoint": "DELETE /service/todos/{id}",
      "purpose": "service/todos 删除（crud_routes 工厂展开）"
    },
    {
      "endpoint": "DELETE /service/todos/batch",
      "purpose": "service/todos 批量删除（crud_routes 工厂展开）"
    }
  ],
  "subscribes": []
}
