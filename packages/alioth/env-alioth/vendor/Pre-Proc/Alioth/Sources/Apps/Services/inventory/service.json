  "publishes": [],
  "services": [
    {
      "endpoint": "GET /service/inventory/statistics",
      "purpose": "库存统计查询（读物化储量，按 产品/储元 过滤；时空伴随：仅统计 rr_storage.qk_period 覆盖 now() 的生效关系；读侧对照：附带最近盘点实盘截止值与盘盈盘亏差异）"
    },
    {
      "endpoint": "GET /service/inventory/statistics/{id}",
      "purpose": "单条库存统计"
    },
    {
      "endpoint": "CRUD /service/inventory/vouchers",
      "purpose": "货 stock in/out 储元（写触发物化：净变 + 余额链回填）"
    },
    {
      "endpoint": "CRUD /service/inventory/countings",
      "purpose": "盘点事件头（范例/实例，盘哪些货经 event_rr_matter，实盘数在明细 deta-counting）"
    },
    {
      "endpoint": "CRUD /service/inventory/counting-details",
      "purpose": "盘点明细（实盘截止值记录；创建时自动校准：账实差异生成校准凭证，经 voucher 链路自动触发物化）"
    },
    {
      "endpoint": "CRUD /service/inventory/storage-nests",
      "purpose": "储元⇲储元 时空嵌套（行存在=置入，删除=取出）"
    }
  ],
  "subscribes": [],
  "version": "0.2.0"
