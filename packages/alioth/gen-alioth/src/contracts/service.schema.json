{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-alioth.local/schemas/service.json",
  "title": "Alioth service.json",
  "description": "Alioth service artifact (ontology-mapping input). Evidence: the real `service.json` fixture of the vendored ontology-mapping crate in the model distribution.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "domain", "version", "ontology"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "domain": { "type": "string" },
    "services": { "type": "array", "items": { "type": "string" } },
    "layer": { "type": "integer" },
    "dtoDependencies": { "type": "array", "items": { "type": "string" } },
    "backendCrate": { "type": "string" },
    "hasBackend": { "type": "boolean" },
    "hasFrontend": { "type": "boolean" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "ontology": {
      "type": "object",
      "additionalProperties": true,
      "required": ["entities"],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "table", "inherits"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "table": { "type": "string", "minLength": 1 },
              "inherits": { "type": "string", "minLength": 1 },
              "coordinates": {
                "type": "object",
                "required": ["scene", "factor", "function"],
                "properties": {
                  "scene": { "type": "string" },
                  "factor": { "type": "string" },
                  "function": { "type": "string" }
                }
              },
              "field_mappings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["json_path", "column"],
                  "properties": {
                    "json_path": { "type": "string" },
                    "column": { "type": "string" },
                    "scalar": { "type": "string" }
                  }
                }
              },
              "relationships": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["target", "type", "via"],
                  "properties": {
                    "target": { "type": "string" },
                    "type": { "type": "string" },
                    "via": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
