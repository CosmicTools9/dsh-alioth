  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./password": "./src/password.ts",
    "./store": "./src/store.ts",
    "./oidc": "./src/oidc.ts",
    "./secretbox": "./src/secretbox.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@dsh-alioth/env-alioth": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.1",
