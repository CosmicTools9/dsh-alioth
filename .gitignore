node_modules/
lib/

# The vendored framework ships its own scripts/lib (prototype gates import it);
# build output elsewhere stays ignored.
!packages/alioth/env-alioth/vendor/**/lib/
# scripts/lib is hand-authored repo tooling (the framework-sync reachability
# module), not build output — the bare `lib/` rule above would drop it.
!scripts/lib/
# Exception: auth-web-alioth's browser half is a HAND-AUTHORED closure-factory
# artifact (no build step exists for it) — it must ship with the source.
!packages/alioth/auth-web-alioth/lib/
dist/
.sessions/
*.log
.DS_Store
.env

# TypeScript incremental build info
*.tsbuildinfo

# Coverage reports (pnpm run test:coverage and per-package report dirs)
coverage*/

# Deployment TLS material (CA-issued certificates and private keys).
# Keys must never enter the repository — ship them to the host out of band.
ca/

# The model registry rows are DERIVED data (a `pg_dump --data-only --inserts` of the model's
# isahl_meta) and NEVER enter Git under this name: this package ships no model snapshot
# (`builtin` was retired 2026-09-24), the runtime reads them from `ALIOTH_MODEL_SOURCE`, and the
# assembler (`scripts/assemble-model-source.ts`) writes them under `<source>/backend/ddl/`.
# The structure baseline (`002_isahl_meta_schema.sql`) stays frozen in the vendor tree.
isahl_meta-registry.sql
