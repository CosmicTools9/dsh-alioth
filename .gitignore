node_modules/
lib/

# The vendored framework ships its own scripts/lib (prototype gates import it);
# build output elsewhere stays ignored.
!packages/alioth/env-alioth/vendor/**/lib/
# Exception: auth-web-alioth's browser half is a HAND-AUTHORED closure-factory
# artifact (no build step exists for it) — it must ship with the source.
!packages/alioth/auth-web-alioth/lib/
dist/
.sessions/
*.log
.DS_Store
.env

# TypeScript incremental build info
*.tsbuildinfo

# Coverage reports (pnpm run test:coverage and per-package report dirs)
coverage*/

# Deployment TLS material (CA-issued certificates and private keys).
# Keys must never enter the repository — ship them to the host out of band.
ca/
